# course.conf — put it in a course folder (or in any subfolder).
# Format: key = value (YAML-style "key: value" also works).
# Comments start with # ; to use # inside a value, wrap the value in quotes.

pinned = true                    # true/1/yes/sim: pinned at the top
title = Active Directory Exploitation      # overrides the folder name (optional)
description = Notes and lessons on attacking AD environments.
tags = Active Directory, Pentest, Windows, Kerberos

# Cover: image inside this folder or the library (relative or absolute path), or external URL.
# Without "banner", the app uses banner.*/cover.*/capa.* from the folder, or a gradient.
banner = banner.jpg
# banner = https://example.com/cover.png
# banner = none                  # no cover (disables automatic detection)
# banner_pos = 30               # vertical framing of the cover: 0 = top, 50 = center, 100 = bottom

# Optional
# status = In progress           # fixed label on the card (otherwise computed from progress)
# color = #1e3a8a                # base gradient color when there is no banner
# order = 1                      # manual order (lowest first, after pinned folders)
# hidden = true                  # hides the folder from the library
